{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-debug",
      "displayName": "Limiter x64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LIMITER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "x64-release",
      "displayName": "Limiter x64 Release",
      "inherits": "x64-debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LIMITER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "core-tests",
      "displayName": "Limiter core tests",
      "inherits": "x64-debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LIMITER_CORE_TESTS_ONLY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "core-tests",
      "configurePreset": "core-tests"
    }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-tests",
      "configurePreset": "core-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
